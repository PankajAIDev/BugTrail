# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Supabase Database & Auth Configuration
# ==============================================================================
# Obtain these from your Supabase Dashboard -> Project Settings -> API:
# 1. Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Project anon/public API Key (Safe for browser client usage with RLS enabled)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
